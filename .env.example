# Public HTTPS origin: required for production canonicals and API origin validation
PUBLIC_SITE_URL=https://herb-all.example
# Optional public contact overrides. Empty strings hide that channel.
PUBLIC_BUSINESS_EMAIL=
PUBLIC_PHONE_NUMBER=
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_ENABLE_NETLIFY_FORM=false

# Runtime variables: configure in Netlify Functions, never with a PUBLIC_ prefix
# Use a pooled PostgreSQL connection URL. No database/credentials are provisioned by the build.
DATABASE_URL=
DATABASE_SSL=true
# Keep production for deployed functions. development permits HTTP cookies only locally.
APP_ENV=production
# Generate once with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep stable: rotating invalidates checkout-retry tracking-key derivation.
ORDER_TOKEN_SECRET=
# Explicit launch switch: keep false until infrastructure, catalogue and checkout are verified.
# A separate staging environment may set true for designated-account testing.
COMMERCE_CHECKOUT_ENABLED=false

# Optional Google Routes server key: restricted to Routes API and permitted server traffic.
GOOGLE_ROUTES_API_KEY=
# Owner-verified origin only; blank means manual delivery review (no invented Rongai coordinates).
FARM_LATITUDE=
FARM_LONGITUDE=

# Optional supported Resend notifications; verified sender required.
RESEND_API_KEY=
NOTIFICATION_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Pochi details are intentionally not inferred from the public contact number.
# A super administrator must configure verified payee, phone, instructions and enable
# payment in Business settings after checking the real account.
