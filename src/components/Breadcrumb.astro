---
import JsonLd from './JsonLd.astro';
import { site } from '../config/site';
interface Props {
  category: string;
  categoryUrl: string;
  title: string;
}
const { category, categoryUrl, title } = Astro.props;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: category, url: categoryUrl },
  { name: title, url: Astro.url.pathname },
];
---

<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 ? (
          <a href={c.url}>{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.url, site.siteUrl).href,
    })),
  }}
/>
