---
import { enquiryPath } from '../config/brand';
---

<section>
  <div class="container cta-panel">
    <div>
      <p class="eyebrow">Let’s take the next step</p>
      <h2>Start with a conversation.</h2>
      <p>
        Tell David what you’d like to explore. Visit dates, session content, any
        fees and directions are confirmed directly before an arrangement is
        agreed.
      </p>
    </div>
    <div class="cta-actions">
      <a class="button light" href={enquiryPath('Garden visit')}>
        Enquire about a visit
      </a>
      <a class="cta-secondary" href={enquiryPath('Consultation')}>
        Discuss a consultation
      </a>
    </div>
  </div>
</section>
