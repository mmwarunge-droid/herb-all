---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, socialLinks } from '../config/site';
import { founder } from '../config/brand';
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const links = [
  ['Home', '/'],
  ['Herbal Products', '/products/'],
  ['Seedlings', '/seedlings/'],
  ['Gardens', '/gardens/'],
  ['Learn', '/learn/'],
  ['About', '/about/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153c2e" />
    <SEO {...Astro.props} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="announcement">Rooted in nature. Shared with everyone.</div>
    <header class="header">
      <div class="container nav-shell">
        <a class="brand" href="/" aria-label="Herb-All home">
          <span class="brand-mark" aria-hidden="true">
            ✳
          </span>{' '}
          herb-all<span class="brand-dot">.</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {links.map(([label, url]) => (
            <a
              href={url}
              aria-current={Astro.url.pathname === url ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
          <a href="/contact/" class="button small">
            Get in touch
          </a>
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {[...links, ['Contact', '/contact/']].map(([label, url]) => (
              <a href={url}>{label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            ✳ herb-all.
          </a>
          <p>
            Plants. Wellness. Knowledge.
            <br />
            Herbs for all, a little closer to nature.
          </p>
          <SocialLinks />
        </div>
        <div>
          <strong>Explore</strong>
          <a href="/products/">Herbal products</a>
          <a href="/seedlings/">Seedlings</a>
          <a href="/learn/">Knowledge hub</a>
        </div>
        <div>
          <strong>Herb-All</strong>
          <a href="/about/">Our story & founder</a>
          <a href="/gardens/">Gardens, visits & learning</a>
          <a href="/contact/">Contact & enquiries</a>
          <a href="/disclaimer/">Health information policy</a>
        </div>
        <div>
          <strong>Good to know</strong>
          <p>
            Educational information, not medical advice. Catalogue samples: ask
            us about ingredients and availability.
          </p>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Herb-All</span>
        <span>Naturally better living.</span>
      </div>
    </footer>
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.organization.name,
        url: site.siteUrl,
        founder: { '@type': 'Person', name: founder.name },
        ...(site.email ? { email: site.email } : {}),
        ...(socialLinks.length
          ? { sameAs: socialLinks.map((l) => l.url) }
          : {}),
      }}
    />
  </body>
</html>
