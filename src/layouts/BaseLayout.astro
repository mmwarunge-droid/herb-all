---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navigation from '../components/Navigation.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, socialLinks } from '../config/site';
import { founder } from '../config/brand';
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153c2e" />
    <SEO {...Astro.props} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="announcement">Rooted in nature. Shared with everyone.</div>
    <Navigation />
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            ✳ herb-all.
          </a>
          <p>
            Plants. Wellness. Knowledge.
            <br />
            Herbs for all, a little closer to nature.
          </p>
          <SocialLinks />
        </div>
        <div>
          <strong>Explore</strong>
          <a href="/shop/">Shop live products</a>
          <a href="/order/">Track an order</a>
          <a href="/products/">Herbal products</a>
          <a href="/seedlings/">Seedlings</a>
          <a href="/learn/">Knowledge hub</a>
        </div>
        <div>
          <strong>Herb-All</strong>
          <a href="/about/">Our story & founder</a>
          <a href="/gardens/">Gardens, visits & learning</a>
          <a href="/contact/">Contact & enquiries</a>
          <a href="/disclaimer/">Health information policy</a>
        </div>
        <div>
          <strong>Good to know</strong>
          <p>
            Educational information, not medical advice. Catalogue samples: ask
            us about ingredients and availability.
          </p>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/image-credits/">Image credits</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Herb-All</span>
        <span>Naturally better living.</span>
      </div>
    </footer>
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.organization.name,
        url: site.siteUrl,
        founder: { '@type': 'Person', name: founder.name },
        ...(site.email ? { email: site.email } : {}),
        ...(socialLinks.length
          ? { sameAs: socialLinks.map((l) => l.url) }
          : {}),
      }}
    />
  </body>
</html>

<script>
  import '../scripts/cart-count';
</script>
