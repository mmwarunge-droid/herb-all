---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This Herb-All page could not be found. Explore the catalogue or knowledge hub."
  noindex
>
  <section class="container">
    <p class="eyebrow">404 · A different path</p>
    <h1>This page hasn’t taken root.</h1>
    <p>Try the herbal catalogue, seedlings or knowledge hub.</p>
    <div class="actions">
      <a class="button" href="/">
        Back to home
      </a>
      <a class="button outline" href="/products/">
        Explore products
      </a>
    </div>
  </section>
</BaseLayout>
