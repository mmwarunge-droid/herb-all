---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderStory from '../components/FounderStory.astro';
import EnquiryPanel from '../components/EnquiryPanel.astro';
import { founder, photos, enquiryPath } from '../config/brand';
---

<BaseLayout
  title="Our story & founder David Mureu Warunge"
  description="Meet David Mureu Warunge, founder of Herb-All. Explore his laboratory research background, garden work and approach to sharing botanical knowledge."
  image={photos.founderGarden}
>
  <header class="container page-heading">
    <p class="eyebrow">The person behind the plants</p>
    <h1>
      A life of curiosity.
      <br />A garden of possibilities.
    </h1>
    <p>
      Herb-All connects botanical products, useful seedlings and practical plant
      knowledge. Its story is also David’s: an interest in research carried into
      cultivation, organic farming and learning.
    </p>
  </header>
  <FounderStory detailed />
  <section id="research" class="tinted">
    <div class="container research-grid">
      <div>
        <p class="eyebrow">Laboratory experience & research</p>
        <h2>
          A scientific background.
          <br />A careful perspective.
        </h2>
      </div>
      <div>
        <p>
          David’s supplied biography connects his parasitology experience to a
          2015 study of <em>Azadirachta indica</em> and{' '}
          <em>Ekebergia capensis</em> in mice infected with{' '}
          <em>Schistosoma mansoni</em>. The publication lists a co-author as
          David Muriu.
        </p>
        <p>
          The study examined plant extracts in an animal model. It does not
          establish that a Herb-All product is effective or safe for people, and
          it should not be used as a treatment recommendation.
        </p>
        <a
          class="text-link"
          href={founder.researchUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the 2015 mouse-study publication
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <p class="research-note">
          Herb-All is independent. References to prior institutional work do not
          imply KEMRI endorsement, a medical licence or a clinical
          qualification.
        </p>
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What guides Herb-All</p>
          <h2>Plants, with care and context.</h2>
        </div>
      </div>
      <div class="pillars">
        <div>
          <span class="pillar-number">01</span>
          <h3>Natural wellness</h3>
          <p>
            Explore plants as part of everyday life. Keep traditional use,
            nutrition and clinical evidence distinct.
          </p>
        </div>
        <div>
          <span class="pillar-number">02</span>
          <h3>Plant knowledge</h3>
          <p>
            Learn through conversations and practical observation. Detailed
            scientific claims need credible sources.
          </p>
        </div>
        <div>
          <span class="pillar-number">03</span>
          <h3>Growing better</h3>
          <p>
            Ask about useful plants, seedlings and locally suitable growing
            approaches before putting down roots.
          </p>
        </div>
      </div>
      <div class="actions">
        <a class="button" href="/gardens/">
          See the gardens & learning
        </a>
        <a class="button outline" href={enquiryPath('Practical learning')}>
          Ask about Rigita learning
        </a>
      </div>
    </div>
  </section>
  <EnquiryPanel />
</BaseLayout>
