---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
---

<BaseLayout
  title="About Herb-All"
  description="Meet Herb-All: a botanical catalogue and learning space built around natural wellness, plant knowledge and growing better."
>
  <header class="container page-heading">
    <p class="eyebrow">Herbs for all</p>
    <h1>
      A shared curiosity.
      <br />A greener everyday.
    </h1>
    <p>
      Herb-All brings herbal products, useful seedlings and thoughtful plant
      knowledge into one place. We believe getting closer to plants starts with
      asking good questions.
    </p>
  </header>
  <section class="container story-grid">
    <Picture
      src="/images/botanical.webp"
      alt="Green botanical leaves catching the sunlight"
      class="story-photo"
    />
    <div>
      <h2>Plants. Wellness. Knowledge.</h2>
      <p>
        We’re building a space for people interested in herbal teas, plant-based
        ingredients and the things they can grow. African botanical heritage is
        part of that curiosity — approached with respect, context and care,
        without treating all traditions as the same.
      </p>
      <p>
        We are a catalogue and educational platform, not a medical provider. We
        distinguish traditional use from scientific evidence and avoid promises
        that plants can replace healthcare.
      </p>
      <a class="text-link" href="/disclaimer/">
        Our approach to health information
      </a>
    </div>
  </section>
  <section class="tinted">
    <div class="container pillars">
      <div>
        <span class="pillar-number">01</span>
        <h3>Natural wellness</h3>
        <p>
          Helping people learn about plants, herbs and plant-based nutrition as
          part of a balanced lifestyle.
        </p>
      </div>
      <div>
        <span class="pillar-number">02</span>
        <h3>Plant knowledge</h3>
        <p>
          Making traditional and modern information easier to explore, while
          being honest about evidence and uncertainty.
        </p>
      </div>
      <div>
        <span class="pillar-number">03</span>
        <h3>Growing better</h3>
        <p>
          Connecting home growers and farmers with useful seedlings and the
          questions that support a good start.
        </p>
      </div>
    </div>
  </section>
  <section class="container">
    <div class="cta-panel">
      <div>
        <h2>Let’s keep growing.</h2>
        <p>Have a question about a plant or product? Start a conversation.</p>
      </div>
      <a class="button light" href="/contact/">
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
