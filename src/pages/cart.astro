---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommerceShell from '../components/CommerceShell.astro';
import { frontendOnly } from '../config/site';
import Offline from '../components/OfflineCommerce.astro';
---

<BaseLayout
  title="Your shopping cart"
  description={
    frontendOnly
      ? 'Online services are temporarily unavailable. Contact Herb-All directly for enquiries.'
      : 'Review Herb-All quantities and current prices. Confirm your merchandise subtotal and delivery or farm collection terms before checkout.'
  }
  noindex
>
  {frontendOnly ? (
    <Offline kind="cart" />
  ) : (
    <>
      <CommerceShell title="Your growing collection.">
        <p slot="intro">
          Prices and stock are checked again on the server. Transport is quoted
          separately by Herb-All.
        </p>
        <div id="cart-content"></div>
        <div class="actions">
          <a class="button outline" href="/shop/">
            Continue shopping
          </a>
          <a class="button" id="checkout-link" href="/checkout/" hidden>
            Proceed to checkout
          </a>
        </div>
      </CommerceShell>
    </>
  )}
</BaseLayout>
<script>
  if (import.meta.env.PUBLIC_FRONTEND_ONLY !== 'true')
    import('../scripts/storefront');
</script>
