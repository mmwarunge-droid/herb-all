---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Enquiry confirmation"
  description="Confirmation page for a Herb-All contact enquiry."
  noindex
>
  <section class="container">
    <p class="eyebrow">Let’s keep growing</p>
    <h1>Thank you for getting in touch.</h1>
    <p>
      If you arrived here after submitting our contact form, your message has
      been submitted. We’ll review your enquiry. An enquiry is not a confirmed
      order.
    </p>
    <div class="actions">
      <a class="button" href="/products/">
        Explore herbal products
      </a>
      <a class="button outline" href="/contact/">
        Back to contact
      </a>
    </div>
  </section>
</BaseLayout>
