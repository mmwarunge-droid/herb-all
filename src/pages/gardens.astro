---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import EnquiryPanel from '../components/EnquiryPanel.astro';
import { photos, enquiryPath, founder } from '../config/brand';
const gallery = [
  {
    image: photos.garden,
    alt: 'Aloe and leafy herbs growing among plants in nursery bags',
    title: 'A mixed growing space',
    body: 'Different useful plants brought together in a container garden.',
  },
  {
    image: photos.moringa,
    alt: 'Young moringa plants growing in black nursery bags',
    title: 'Moringa seedlings',
    body: 'A closer look at young plants. Ask about the current nursery selection.',
  },
  {
    image: photos.rosemary,
    alt: 'Rosemary seedlings with narrow leaves growing in nursery bags',
    title: 'Rosemary seedlings',
    body: 'Herbs for a growing space, with availability confirmed on enquiry.',
  },
  {
    image: photos.founderGarden,
    alt: 'David Mureu Warunge examining plants and holding a notebook in the garden',
    title: 'Learning through observation',
    body: 'David’s practical interest in cultivation and plant knowledge.',
  },
];
const activities = [
  {
    title: 'Garden visits',
    image: photos.growing,
    alt: 'Leafy plants and seedlings arranged in a container garden',
    body: 'Arrange a visit with David to explore the growing space and discuss the plants that interest you. Ask about suitable dates, group size and any fees before making travel plans.',
    topic: 'Garden visit' as const,
    cta: 'Enquire about a garden visit',
  },
  {
    title: 'Consultations with David',
    image: photos.founderGarden,
    alt: 'David Mureu Warunge looking at a leafy plant in the garden',
    body: 'Start a conversation about botanical products, cultivation or your growing plans. Explain your interests so the purpose and scope of a session can be agreed before booking.',
    topic: 'Consultation' as const,
    cta: 'Discuss a consultation',
  },
  {
    title: 'Practical learning',
    image: photos.rosemary,
    alt: 'Rosemary seedlings in nursery bags',
    body: 'Ask about learning through Rigita Herbal Medicine School, with a focus on herbal cultivation and organic farming. Session topics, dates and arrangements are confirmed directly.',
    topic: 'Practical learning' as const,
    cta: 'Ask about learning opportunities',
  },
];
---

<BaseLayout
  title="Herb-All gardens, visits & practical learning"
  description="Explore Herb-All garden photographs, herbal seedlings and wheatgrass growing. Enquire about visits, consultations and learning with David in Ongata Rongai."
  image={photos.growing}
>
  <header class="container page-heading">
    <p class="eyebrow">The Herb-All gardens · Ongata Rongai, Kenya</p>
    <h1>
      Grow something useful.
      <br />
      Learn something lasting.
    </h1>
    <p>
      A growing space for herbal plants, seedlings and kitchen gardening — and a
      starting point for conversations about cultivation and organic farming.
    </p>
    <div class="actions">
      <a class="button" href={enquiryPath('Garden visit')}>
        Enquire about a garden visit
      </a>
      <a class="text-link" href="#learning">
        Explore visits & learning
      </a>
    </div>
  </header>
  <section class="container garden-overview">
    <Picture
      src={photos.growing}
      alt="Leafy plants in yellow containers, aloe and rows of seedlings in a garden"
      eager
      class="garden-cover"
      sizes="(max-width: 760px) calc(100vw - 32px), 1200px"
    />
    <div class="garden-overview-copy">
      <p>
        Herb-All’s garden work brings together herbal cultivation, container
        growing and agro-ecological practices. The photographs offer a closer
        look at the plants and growing space; they are not a dated timeline or a
        promise of what will be available on a particular day.
      </p>
      <p>
        Visits are by arrangement with {founder.name}. The general location is{' '}
        {founder.location}; precise directions and visit details are supplied
        when an arrangement is agreed.
      </p>
    </div>
  </section>
  <section class="tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Look closer</p>
          <h2>Inside the growing collection.</h2>
          <p>Plants, containers and the hands-on work that connects them.</p>
        </div>
      </div>
      <div class="garden-gallery">
        {gallery.map((g) => (
          <figure>
            <Picture
              src={g.image}
              alt={g.alt}
              sizes="(max-width: 760px) calc(100vw - 32px), 580px"
              class={
                g.image === photos.founderGarden
                  ? 'gallery-photo portrait-full'
                  : 'gallery-photo'
              }
            />
            <figcaption>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <section id="wheatgrass">
    <div class="container story-grid">
      <Picture
        src={photos.wheatgrass}
        alt="Dense upright wheatgrass shoots growing in a rectangular tray"
        class="wheatgrass-photo"
      />
      <div>
        <p class="eyebrow">Wheatgrass cultivation</p>
        <h2>
          A closer look at
          <br />
          the growing tray.
        </h2>
        <p>
          Explore wheatgrass as part of the garden’s plant collection. If it
          interests you, ask about current growing options, product formats and
          availability before placing an order.
        </p>
        <p>
          There are no published prices, quantities or preparation instructions
          here. Any product details are confirmed directly; no nutritional
          values, dosages or medical benefits are promised.
        </p>
        <div class="actions">
          <a
            class="button"
            href={enquiryPath('Products & seedlings', 'Wheatgrass')}
          >
            Ask about wheatgrass
          </a>
        </div>
      </div>
    </div>
  </section>
  <section id="learning" class="tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Visit. Ask. Learn.</p>
          <h2>Find your way into Herb-All.</h2>
          <p>
            Tell David what you’d like to see or learn. These are enquiries,
            with arrangements agreed personally.
          </p>
        </div>
      </div>
      <div class="card-grid activity-grid">
        {activities.map((a) => (
          <article class="card">
            <Picture
              src={a.image}
              alt={a.alt}
              class="activity-photo"
              sizes="(max-width: 480px) calc(100vw - 32px), 390px"
            />
            <div class="card-body">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
              <a class="text-link" href={enquiryPath(a.topic)}>
                {a.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
      <aside class="safety-note">
        <strong>A conversation, not a treatment promise.</strong>
        <p>
          Educational plant discussions do not replace qualified healthcare
          advice. Ask about the scope of a consultation; do not stop prescribed
          treatment or send private medical records through the enquiry form.
        </p>
        <a href="/disclaimer/">Read the health information policy</a>
      </aside>
    </div>
  </section>
  <EnquiryPanel />
</BaseLayout>
