---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Picture from '../components/Picture.astro';
import SocialLinks from '../components/SocialLinks.astro';
import {
  publishedProducts,
  publishedSeedlings,
  publishedArticles,
} from '../utils/content';
const products = (await publishedProducts()).filter((e) => e.data.featured);
const seedlings = (await publishedSeedlings()).filter((e) => e.data.featured);
const articles = (await publishedArticles()).slice(0, 3);
---

<BaseLayout
  title="Plants. Wellness. Knowledge."
  description="Discover Herb-All herbal teas, botanical products, practical plant knowledge and fruit tree seedlings. Explore our catalogue and enquire directly."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Herbs for all · Naturally better living</p>
        <h1>
          A little closer
          <br />
          to <em>nature.</em>
        </h1>
        <p class="hero-description">
          Plants. Wellness. Knowledge.
          <br />
          Discover herbal teas, botanical products and quality seedlings — with
          the knowledge to make thoughtful choices.
        </p>
        <div class="actions">
          <a class="button" href="/products/">
            Explore herbal products
          </a>
          <a class="button outline" href="/seedlings/">
            Browse seedlings
          </a>
        </div>
        <p class="muted">For your everyday rituals. For the things you grow.</p>
      </div>
      <div class="hero-photo">
        <Picture
          src="/images/botanical.webp"
          alt="Fresh green tea leaves growing in a sunlit plantation"
          eager
        />
        <div class="hero-caption">
          <span>FROM THE EARTH, WITH CARE</span>
          <p>Good things start with plants.</p>
        </div>
      </div>
    </div>
  </section>
  <div class="container values-strip">
    <span>Botanical products & herbal teas</span>
    <span>Fruit trees & useful seedlings</span>
    <span>Plant knowledge, thoughtfully shared</span>
  </div>
  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The herbal collection</p>
          <h2>Your next everyday ritual.</h2>
          <p>
            Meet familiar botanicals in a new way. Explore our sample catalogue,
            then ask about ingredients and availability.
          </p>
        </div>
        <a class="text-link" href="/products/">
          View all herbal products
        </a>
      </div>
      <div class="card-grid">
        {products.map((entry) => (
          <Card entry={entry} />
        ))}
      </div>
    </div>
  </section>
  <section class="tinted">
    <div class="container story-grid">
      <Picture
        src="/images/seedlings.webp"
        alt="Young seedlings growing in nursery pots"
        class="story-photo"
      />
      <div>
        <p class="eyebrow">Growing better</p>
        <h2>
          Plant something.
          <br />
          Grow a possibility.
        </h2>
        <p>
          From a home garden to a growing orchard, the right seedling is a place
          to begin. Explore fruit trees and useful plants, and ask us what suits
          your growing plans.
        </p>
        <div class="actions">
          <a class="button" href="/seedlings/">
            Find your seedling
          </a>
        </div>
        <p class="muted">
          Availability and cultivar information confirmed on enquiry.
        </p>
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The seedling collection</p>
          <h2>Good roots. Fresh starts.</h2>
        </div>
        <a class="text-link" href="/seedlings/">
          View all seedlings
        </a>
      </div>
      <div class="card-grid">
        {seedlings.map((entry) => (
          <Card entry={entry} />
        ))}
      </div>
    </div>
  </section>
  <section class="tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Why Herb-All?</p>
          <h2>
            Rooted in plants.
            <br />
            Grounded in care.
          </h2>
        </div>
        <a href="/about/" class="text-link">
          Get to know us
        </a>
      </div>
      <div class="pillars">
        <div>
          <span class="pillar-number">01</span>
          <h3>Natural wellness</h3>
          <p>
            Explore plant-based ingredients as part of a varied, balanced
            lifestyle, without miracle promises.
          </p>
        </div>
        <div>
          <span class="pillar-number">02</span>
          <h3>Plant knowledge</h3>
          <p>
            A place for botanical curiosity, traditional plant knowledge and a
            clear distinction between tradition and evidence.
          </p>
        </div>
        <div>
          <span class="pillar-number">03</span>
          <h3>Growing better</h3>
          <p>
            Help for choosing useful plants and asking the right questions
            before putting down roots.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The Herb-All journal</p>
          <h2>A little knowledge goes a long way.</h2>
          <p>
            Learn about herbs, preparation and growing — one thoughtful guide at
            a time.
          </p>
        </div>
        <a href="/learn/" class="text-link">
          Explore the knowledge hub
        </a>
      </div>
      <div class="card-grid">
        {articles.map((entry) => (
          <Card entry={entry} />
        ))}
      </div>
      <div class="taxonomy" aria-label="Popular plants">
        <span>Explore popular plants:</span>
        <a href="/products/moringa-tea/">Moringa</a>
        <a href="/products/hibiscus-tea/">Hibiscus</a>
        <a href="/products/ginger-herbal-tea/">Ginger</a>
        <a href="/seedlings/avocado/">Avocado</a>
      </div>
    </div>
  </section>
  <section>
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">Let’s talk plants</p>
        <h2>Found something you love?</h2>
        <p>
          Ask about products, seedlings and availability. We’ll help you take
          the next step.
        </p>
      </div>
      <a class="button light" href="/contact/">
        Get in touch
      </a>
    </div>
  </section>
  <div class="container social-band">
    <p class="eyebrow">Keep growing with us</p>
    <h2>More plants. More everyday inspiration.</h2>
    <SocialLinks />
  </div>
</BaseLayout>
