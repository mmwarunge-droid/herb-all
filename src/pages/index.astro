---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Picture from '../components/Picture.astro';
import FounderStory from '../components/FounderStory.astro';
import EnquiryPanel from '../components/EnquiryPanel.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { publishedArticles } from '../utils/content';
import { photos, enquiryPath } from '../config/brand';
const articles = (await publishedArticles()).slice(0, 3);
const offerings = [
  {
    title: 'Herbal products',
    label: 'For your everyday rituals',
    image: photos.packaged,
    alt: 'Three jars of powdered herbs labelled moringa',
    body: 'Explore our herbal catalogue and ask about the complete ingredients, preparation and currently available products.',
    url: '/products/',
    cta: 'Explore herbal products',
  },
  {
    title: 'Plants to grow',
    label: 'A good start, with good roots',
    image: photos.moringa,
    alt: 'Moringa seedlings growing in black nursery bags',
    body: 'Discover useful seedlings, starting with moringa. Ask about plant sizes, suitable growing conditions and availability.',
    url: '/seedlings/',
    cta: 'Browse seedlings',
  },
  {
    title: 'Gardens & cultivation',
    label: 'See how things grow',
    image: photos.wheatgrass,
    alt: 'Dense green wheatgrass growing in a tray',
    body: 'Get closer to herbal cultivation, container gardening and wheatgrass growing, and enquire about a visit.',
    url: '/gardens/',
    cta: 'Discover the gardens',
  },
];
---

<BaseLayout
  title="Botanical products, gardens & plant knowledge"
  description="Discover Herb-All botanical products, seedlings and gardens in Ongata Rongai. Meet founder David Muriu Warunge and enquire about visits and learning."
  image={photos.growing}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Herbs for all · Ongata Rongai, Kenya</p>
        <h1>
          Rooted in plants.
          <br />
          Shared through <em>knowledge.</em>
        </h1>
        <p class="hero-description">
          Herb-All brings together botanical products, useful seedlings and
          practical learning — with founder David Muriu Warunge at the heart of
          the garden.
        </p>
        <div class="actions">
          <a class="button" href="/products/">
            Explore herbal products
          </a>
          <a class="button outline" href="/gardens/">
            Discover the gardens
          </a>
        </div>
        <a class="text-link" href="/about/#founder">
          Meet David
        </a>
      </div>
      <div class="hero-photo">
        <Picture
          src={photos.growing}
          alt="Container-grown leafy plants, aloe and seedlings in the Herb-All garden collection"
          eager
          sizes="(max-width: 760px) calc(100vw - 32px), 580px"
        />
        <div class="hero-caption">
          <span>PLANTS. WELLNESS. KNOWLEDGE.</span>
          <p>Growing, learning and sharing.</p>
        </div>
      </div>
    </div>
  </section>
  <div class="container values-strip">
    <span>Herbal products & seedlings</span>
    <span>Garden visits by arrangement</span>
    <span>Practical plant knowledge</span>
  </div>
  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Explore Herb-All</p>
          <h2>
            From the growing space
            <br />
            to your everyday.
          </h2>
          <p>
            Discover the plants, products and conversations that bring Herb-All
            together.
          </p>
        </div>
      </div>
      <div class="card-grid offering-grid">
        {offerings.map((o) => (
          <article class="card">
            <a class="card-image" href={o.url} tabindex="-1" aria-hidden="true">
              <Picture
                src={o.image}
                alt={o.alt}
                sizes="(max-width: 480px) calc(100vw - 32px), (max-width: 760px) 45vw, 390px"
                class="product-photo"
              />
            </a>
            <div class="card-body">
              <p class="eyebrow">{o.label}</p>
              <h3>
                <a href={o.url}>{o.title}</a>
              </h3>
              <p>{o.body}</p>
              <a class="text-link" href={o.url}>
                {o.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="tinted">
    <div class="container story-grid">
      <figure class="garden-feature">
        <Picture
          src={photos.garden}
          alt="A mixed container garden with seedlings, leafy herbs and aloe"
          class="story-photo"
        />
        <figcaption>Useful plants, grown side by side.</figcaption>
      </figure>
      <div>
        <p class="eyebrow">The Herb-All gardens</p>
        <h2>
          A place to grow.
          <br />A place to learn.
        </h2>
        <p>
          Herbal cultivation, kitchen gardening and organic farming practices
          come together in David’s growing space. Look closer at the plants and
          ask how a garden visit or practical learning session could fit your
          interests.
        </p>
        <div class="actions">
          <a class="button" href="/gardens/">
            Explore the garden story
          </a>
          <a class="button outline" href={enquiryPath('Garden visit')}>
            Enquire about a visit
          </a>
        </div>
        <a class="text-link" href="/gardens/#wheatgrass">
          Explore wheatgrass growing
        </a>
      </div>
    </div>
  </section>
  <FounderStory />
  <section class="tinted">
    <div class="container learning-intro">
      <div>
        <p class="eyebrow">Learning, with context</p>
        <h2>
          Botanical curiosity.
          <br />
          Practical experience.
        </h2>
      </div>
      <div>
        <p>
          Through Rigita Herbal Medicine School, David shares an interest in
          herbal cultivation and organic farming. Ask about practical learning
          opportunities and the subjects you’d like to explore.
        </p>
        <p>
          His research background is part of the story. It is not a promise of
          medical benefits or an endorsement of Herb-All products by KEMRI.
        </p>
        <div class="actions">
          <a class="button" href={enquiryPath('Practical learning')}>
            Ask about learning opportunities
          </a>
          <a class="text-link" href="/about/#research">
            Read the research context
          </a>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The Herb-All journal</p>
          <h2>Keep your curiosity growing.</h2>
          <p>
            Guides to plants, preparation and growing — with care around
            evidence and health information.
          </p>
        </div>
        <a class="text-link" href="/learn/">
          Explore the knowledge hub
        </a>
      </div>
      <div class="card-grid">
        {articles.map((entry) => (
          <Card entry={entry} />
        ))}
      </div>
    </div>
  </section>
  <EnquiryPanel />
  <div class="container social-band">
    <p class="eyebrow">Keep growing with us</p>
    <h2>More plants. More everyday inspiration.</h2>
    <SocialLinks />
  </div>
</BaseLayout>
