---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { temporaryImage } from '../../utils/product-images';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import JsonLd from '../../components/JsonLd.astro';
import Card from '../../components/Card.astro';
import { publishedProducts } from '../../utils/content';
import { site, enquiryLink } from '../../config/site';
export async function getStaticPaths() {
  return (await publishedProducts()).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const d = entry.data;
const visual = temporaryImage(`products/${d.slug}`);
const visualSrc = d.image.startsWith('/images/brand/')
  ? d.image
  : visual?.image || d.image;
const { Content } = await render(entry);
const related = (await publishedProducts())
  .filter((e) => e.id !== entry.id)
  .slice(0, 3);
---

<BaseLayout title={d.title} description={d.description} image={visualSrc}>
  <article class="container detail">
    <Breadcrumb
      category="Herbal products"
      categoryUrl="/products/"
      title={d.title}
    />
    <div class="detail-grid">
      <div>
        <ProductVisual
          name={d.title}
          imageKey={`products/${d.slug}`}
          src={d.image}
          alt={d.imageAlt}
          eager
        />
      </div>
      <div>
        <p class="eyebrow">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="botanical">{d.botanicalName}</p>
        <p>{d.description}</p>
        <p class="sample-note">
          Sample catalogue entry. Ingredients, packaging and availability need
          owner confirmation before commercial sale.
        </p>
        {d.price !== undefined && (
          <p>
            {new Intl.NumberFormat('en', {
              style: 'currency',
              currency: d.currency,
            }).format(d.price)}
          </p>
        )}
        <a class="button" href={enquiryLink(d.title)}>
          Enquire about this product
        </a>
        <dl class="facts">
          <dt>Ingredients</dt>
          <dd>{d.ingredients.join(', ')}</dd>
          <dt>Preparation</dt>
          <dd>{d.preparation}</dd>
          <dt>Use with care</dt>
          <dd>
            <ul>
              {d.cautions.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </dd>
        </dl>
      </div>
    </div>
    <div class="prose">
      <Content />
      <MedicalDisclaimer />
    </div>
  </article>
  <section class="container">
    <div class="section-head">
      <h2>Explore more botanicals.</h2>
    </div>
    <div class="card-grid">
      {related.map((entry) => (
        <Card entry={entry} />
      ))}
    </div>
  </section>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: d.title,
      description: d.description,
      image: new URL(visualSrc, site.siteUrl).href,
      url: new URL(Astro.url.pathname, site.siteUrl).href,
      category: d.category,
      brand: { '@type': 'Brand', name: site.siteName },
    }}
  />
</BaseLayout>
