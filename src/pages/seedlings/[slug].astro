---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picture from '../../components/Picture.astro';
import Card from '../../components/Card.astro';
import { publishedSeedlings } from '../../utils/content';
import { enquiryLink } from '../../config/site';
export async function getStaticPaths() {
  return (await publishedSeedlings()).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const related = (await publishedSeedlings())
  .filter((e) => e.id !== entry.id)
  .slice(0, 3);
---

<BaseLayout title={d.title} description={d.description} image={d.image}>
  <article class="container detail">
    <Breadcrumb
      category="Seedlings"
      categoryUrl="/seedlings/"
      title={d.title}
    />
    <div class="detail-grid">
      <div>
        <Picture src={d.image} alt={d.imageAlt} eager class="detail-image" />
        <p class="muted">
          {d.image.startsWith('/images/brand/')
            ? 'Photograph supplied by Herb-All. Current plant size and availability are confirmed on enquiry.'
            : 'Illustrative photograph, not current Herb-All stock.'}
        </p>
      </div>
      <div>
        <p class="eyebrow">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="botanical">{d.botanicalName}</p>
        <p>{d.description}</p>
        <p class="sample-note">
          Sample catalogue entry. Ask about cultivar, plant size and
          availability before ordering.
        </p>
        <a class="button" href={enquiryLink(d.title)}>
          Ask about availability
        </a>
        <dl class="facts">
          <dt>Climate & site</dt>
          <dd>{d.climate}</dd>
          <dt>Maturity expectations</dt>
          <dd>{d.maturity}</dd>
          <dt>Spacing</dt>
          <dd>{d.spacing}</dd>
          <dt>Care</dt>
          <dd>
            <ul>
              {d.care.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </dd>
        </dl>
      </div>
    </div>
    <div class="prose">
      <Content />
      <aside class="safety-note">
        <strong>Every growing site is different.</strong>
        <p>
          Performance varies with cultivar, soil, weather and management. This
          guide does not guarantee yield or a maturity date. Get locally
          appropriate agricultural advice.
        </p>
      </aside>
    </div>
  </article>
  <section class="container">
    <div class="section-head">
      <h2>Keep growing.</h2>
    </div>
    <div class="card-grid">
      {related.map((entry) => (
        <Card entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
